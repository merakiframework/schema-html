# Example wording. In a real application install a published pack instead,
# e.g. Mf2Provider::fromPackage('meraki/schema-language-english').
# Covers every constraint meraki/schema 2.0.0-alpha.2 reports.
@locale = en

shape.missing = This is required.
shape.unreadable = That is not a valid {$kind}.
Enum.shape.unreadable = Choose one of the options.
Collection.shape.unreadable = That is not a list of rows.

kind.Address = address
kind.Boolean = yes or no answer
kind.Collection = list
kind.CreditCard = card
kind.Date = date
kind.DateTime = date and time
kind.Duration = length of time
kind.EmailAddress = email address
kind.Enum = option
kind.File = file
kind.Money = amount
kind.Name = name
kind.Number = number
kind.Password = password
kind.PhoneNumber = phone number
kind.Text = text
kind.Time = time
kind.Uri = web address
kind.Uuid = UUID

part.organization = organisation
part.line1 = street address
part.line2 = second address line
part.dependent_locality = dependent locality
part.locality = locality
part.administrative_area = administrative area
part.postal_code = postal code
part.country = country
part.currency = currency
part.amount = amount
part.number = card number
part.expiry = expiry date
part.name = name on the card
part.security_code = security code

list.separator = {|, |}
list.lastSeparator = {| or |}
bound.true = yes
bound.false = no

minLength = Use at least {$bound} characters.
maxLength = Use no more than {$bound} characters.
pattern = That is not in the expected format.
minValue = Enter {$bound} or more.
maxValue = Enter {$bound} or less.
step = Enter a multiple of {$bound}.
scale = Use no more than {$bound} decimal places.
maxPrecision = Use no more than {$bound} digits.
from = Choose {$bound} or later.
after = Choose something after {$bound}.
until = Choose something before {$bound}.
through = Choose {$bound} or earlier.
interval = Choose a time on the interval.
precision = That is more precise than this accepts.
minSize = The file must be at least {$bound} bytes.
maxSize = The file must be no more than {$bound} bytes.
allowedTypes = Upload one of these types: {$bound}.
disallowedTypes = That type of file is not accepted.
allowedDomains = Use an address at {$bound}.
disallowedDomains = Addresses at that domain are not accepted.
allowedSchemes = Use an address starting with {$bound}.
allowedVersions = Use a version {$bound} UUID.
minStrength = Choose a stronger password.
minUppercaseChars = Use at least {$bound} uppercase letters.
minLowercaseChars = Use at least {$bound} lowercase letters.
minDigits = Use at least {$bound} digits.
minSymbols = Use at least {$bound} symbols.
minCount = Add at least {$bound}.
maxCount = Add no more than {$bound}.
unique = Each row must be different.
accepted = You have to accept this to continue.
allowedCountries = Choose one of these countries: {$bound}.
PhoneNumber.allowedCountries = Enter a phone number from: {$bound}.
numberType = Enter a {$bound} number.
allowedCurrencies = Choose one of these currencies: {$bound}.
minAmount = Enter {$bound} or more.
maxAmount = Enter {$bound} or less.
postalCodeFormat = That is not a valid {$part} for the country you chose.
administrativeArea = That is not a {$part} we recognise for the country you chose.
line1Visitable = Enter a street address: a PO box or bag service is not somewhere that can be visited.
specific = Enter a street address.
numberFormat = That is not a card number.
numberChecksum = That card number is not valid.
expiryFormat = Enter the expiry as a month and year.
expiryInFuture = That card has expired.
expiryWithinReach = That expiry is too far away.
namePresent = Enter the name on the card.
securityCodeFormat = That is not a valid security code.
