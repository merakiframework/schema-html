{
	"name": "schema-html (PHP 8.5)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "dev",
	"postCreateCommand": "composer install",
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "Examples (composer serve)",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": ["bmewburn.vscode-intelephense-client"],
			"settings": {
				"intelephense.environment.phpVersion": "8.5.0"
			}
		}
	}
}
