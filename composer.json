{
    "name": "meraki/schema-html",
    "description": "Render a meraki/schema as an HTML form.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nathan Bishop",
            "email": "nbish11@hotmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../{schema}",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "commerceguys/addressing": "^2.0",
        "meraki/schema": "^2.0.0-alpha.3",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "meraki/schema-language-english": "dev-main",
        "phpunit/phpunit": "^11.3"
    },
    "suggest": {
        "meraki/schema-language-english": "English wording for validation messages. A message pack is required; this is the published English one."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Meraki\\Schema\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Meraki\\Schema\\Html\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
